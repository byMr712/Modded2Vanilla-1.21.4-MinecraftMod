    "homepage": "https://github.com/byMr712/Modded2Vanilla-1.21.4-MinecraftMod"
  },
  "license": "Apache-2.0",
  "icon": "assets/modded2vanilla/icon.png",
  "environment": "client",
  "entrypoints": {
